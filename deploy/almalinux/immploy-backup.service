[Unit]
Description=Back up IMMploy PostgreSQL database and private documents
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/immploy/backup.env
ExecStart=/usr/local/sbin/immploy-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/immploy
ReadOnlyPaths=/var/lib/immploy
ProtectHome=true
PrivateDevices=true
UMask=0077
