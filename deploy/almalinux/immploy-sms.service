[Unit]
Description=Process IMMploy booking SMS outbox
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=immploy
Group=immploy
WorkingDirectory=/opt/immploy/current/backend
EnvironmentFile=/etc/immploy/immploy.env
ExecCondition=/usr/bin/test -n "${SMS_MYMOBILEAPI_CLIENT_ID}"
ExecCondition=/usr/bin/test -n "${SMS_MYMOBILEAPI_SECRET}"
ExecStart=/opt/immploy/venv/bin/python manage.py send_sms_outbox --limit 100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
